; Ultimate VTT — progetto Godot 4 (porting del monolite Vanilla JS/HTML).
; Generato dalla migrazione automatica. Apri questa cartella con Godot 4.3+.
;
; Gli autoload sono elencati NELL'ORDINE DI DIPENDENZA: Godot li inizializza dall'alto verso il
; basso, e i manager piu' in basso usano quelli sopra (CombatManager legge CharacterManager al
; _ready; AIBridge usa tutti gli altri). Non riordinarli a caso.

config_version=5

[application]

config/name="Ultimate VTT — Tavolo Oscuro di Ventimiglia"
config/description="Porting Godot 4 del VTT D&D 5e. Client leggero (Split-Rig); il Master IA gira su un PC remoto via Ollama."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
CharacterManager="*res://scripts/autoload/character_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
ArmeriaManager="*res://scripts/autoload/armeria_manager.gd"
CharacterCreation="*res://scripts/autoload/character_creation.gd"
CombatManager="*res://scripts/combat/combat_manager.gd"
ProgressionManager="*res://scripts/autoload/progression_manager.gd"
ConditionsManager="*res://scripts/combat/conditions_manager.gd"
FlankingSystem="*res://scripts/combat/flanking_system.gd"
ElevationManager="*res://scripts/combat/elevation_manager.gd"
SurfacesManager="*res://scripts/combat/surfaces_manager.gd"
EnemyAI="*res://scripts/combat/enemy_ai.gd"
EncounterBalancer="*res://scripts/combat/encounter_balancer.gd"
ActionMenuManager="*res://scripts/combat/action_menu_manager.gd"
CampaignMemory="*res://scripts/autoload/campaign_memory.gd"
VttCoreManager="*res://scripts/autoload/vtt_core_manager.gd"
LocalGameManager="*res://scripts/autoload/local_game_manager.gd"
LocalInputManager="*res://scripts/autoload/local_input_manager.gd"
AIBridge="*res://scripts/network/ai_bridge.gd"
ChatCombatBridge="*res://scripts/combat/chat_combat_bridge.gd"
ChatTravelBridge="*res://scripts/network/chat_travel_bridge.gd"
MasterVoice="*res://scripts/network/master_voice.gd"
DiceServer="*res://scripts/network/dice_server.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[audio]

general/text_to_speech=true

[rendering]

renderer/rendering_method="forward_plus"
